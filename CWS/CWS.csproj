<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<TargetPlatformControls>true</TargetPlatformControls>
		<AssemblyName>CWS</AssemblyName>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<ManualMinor>4</ManualMinor>
		<Version>0.$(ManualMinor).$([System.DateTime]::UtcNow.ToString("yyMMdd")).$([System.DateTime]::UtcNow.ToString("HHmm"))</Version>
		<AssemblyVersion>0.0.0.0</AssemblyVersion>
		<FileVersion>0.0.0.0</FileVersion>
		<InformationalVersion>v0.$(ManualMinor)-$([System.DateTime]::UtcNow.ToString("HHmm"))($([System.DateTime]::UtcNow.ToString("yyMMdd")))</InformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="SetUserFTA.exe" />
	</ItemGroup>

	<ItemGroup>
		<Page Remove="Langs\en-US.xaml" />
		<Page Remove="Langs\te-Yi.xaml" />
		<Page Remove="Langs\zh-CN.xaml" />
		<Page Remove="Langs\zh-HK.xaml" />
		<Page Remove="Langs\zh-TW.xaml" />
		<Page Remove="Langs\pc-Ba.xaml" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Langs\en-US.xaml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Langs\te-Yi.xaml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Langs\zh-CN.xaml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Langs\zh-HK.xaml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Langs\zh-TW.xaml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Langs\pc-Ba.xaml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="SetUserFTA.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
		<PackageReference Include="WPF-UI" Version="4.2.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Settings.Designer.cs">
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
			<AutoGen>True</AutoGen>
			<DependentUpon>Settings.settings</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<None Update="Properties\Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>

</Project>
