<Window x:Class="CWS.ModernWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CWS Control Center"
        Height="680" Width="1000"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Color Palette -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderLightBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BorderCardBrush" Color="#E8ECF0"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="WindowFrameBorderBrush" Color="#E0E4E8"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="SubtlePanelBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FEF2F2"/>
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#FECACA"/>
        <SolidColorBrush x:Key="DangerTextBrush" Color="#DC2626"/>

        <!-- Title Bar Button Style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SubtlePanelBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BorderLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Toggle Switch -->
        <Style x:Key="ModernToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="12" Background="#CBD5E1" Width="44" Height="24">
                            <Border x:Name="Thumb" CornerRadius="10" Background="{StaticResource CardBackgroundBrush}" Width="20" Height="20"
                                    HorizontalAlignment="Left" Margin="2,0,0,0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect Color="#20000000" BlurRadius="3" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="20"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav ListBox Style -->
        <Style x:Key="NavListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- Language ListBox Style -->
        <Style x:Key="LangListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- Language ListBoxItem Style (compact) -->
        <Style x:Key="LangItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="8,1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" CornerRadius="8" Background="Transparent"
                                Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource SubtlePanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav ListBoxItem Style -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" CornerRadius="10" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource SubtlePanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default Button Style -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SubtlePanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style (reusable border) -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Page Title Style -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Card Title Style -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="false" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=ToggleButton}"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Focusable="False" PopupAnimation="Fade" StaysOpen="False">
                                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                        CornerRadius="8" Width="{Binding ActualWidth, ElementName=ToggleButton}"
                                        MaxHeight="240" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#10000000" BlurRadius="12" ShadowDepth="0"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource SubtlePanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20">
                            <Border Height="4" Background="{StaticResource BorderLightBrush}" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton>
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="{StaticResource AccentBrush}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="18" Height="18" CornerRadius="9"
                                                        Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#20000000" BlurRadius="3" ShadowDepth="0"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separator Style -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource SubtlePanelBrush}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RadioButton Style -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="outerRing" Width="18" Height="18" CornerRadius="9"
                                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="2" Background="Transparent"/>
                            <Border x:Name="innerDot" Width="8" Height="8" CornerRadius="4"
                                    Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="outerRing" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="innerDot" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outerRing" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toast Notification Style -->
        <Style x:Key="ToastBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="MaxWidth" Value="380"/>
        </Style>

        <!-- Toast Slide+Fade In Animation -->
        <Storyboard x:Key="ToastInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="40" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Toast Fade Out Animation -->
        <Storyboard x:Key="ToastOutAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Main Window Container -->
    <Border x:Name="RootBackground" CornerRadius="12" Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource WindowFrameBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Title Bar ===== -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBackgroundBrush}"
                    CornerRadius="12,12,0,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Draggable Title Area -->
                    <Grid Grid.Column="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- App Icon -->
                        <Border Width="32" Height="32" Margin="12,8,10,8" CornerRadius="8"
                                Background="{StaticResource AccentBrush}">
                            <TextBlock Text="C" Foreground="{StaticResource TextOnAccentBrush}" FontWeight="SemiBold" FontSize="15"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0">
                            <TextBlock Text="CWS Control Center" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="btnMinimize_Click"
                                ToolTip="Minimize">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}" Click="OnClose_Click"
                                ToolTip="Close">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Body: Sidebar + Content ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Left Sidebar ===== -->
                <Border Background="{StaticResource SidebarBackgroundBrush}"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Sidebar Header -->
                        <StackPanel Grid.Row="0" Margin="20,20,20,12">
                            <TextBlock Text="CWS" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Control Center" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Navigation -->
                        <ListBox x:Name="NavListBox" Grid.Row="1" Style="{StaticResource NavListBoxStyle}"
                                 Margin="8,4,8,0" SelectedIndex="0"
                                 SelectionChanged="NavListBox_SelectionChanged">
                            <ListBoxItem Style="{StaticResource NavItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.7"/>
                                    <TextBlock Text="{DynamicResource Lang_Nav_DocOpt}" FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.7"/>
                                    <TextBlock Text="{DynamicResource Lang_Nav_General}" FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.7"/>
                                    <TextBlock Text="{DynamicResource Lang_Nav_AssocCenter}" FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.7"/>
                                    <TextBlock Text="{DynamicResource Lang_Nav_ThemeUrl}" FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.7"/>
                                    <TextBlock Text="{DynamicResource Lang_Nav_About}" FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <!-- Sidebar Bottom -->
                        <StackPanel Grid.Row="2" Margin="20,12,20,16">
                            <!-- Language Section Toggle -->
                            <ToggleButton x:Name="btnLangToggle" IsChecked="True"
                                          Background="Transparent" BorderThickness="0"
                                          HorizontalContentAlignment="Stretch"
                                          Cursor="Hand" Padding="0" Height="24">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource Lang_Label_Language}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock x:Name="chevron" Grid.Column="2"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE70E;"
                                                           FontSize="8" Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="chevron" Property="Text" Value="&#xE70E;"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="chevron" Property="Text" Value="&#xE70D;"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Collapsible Language List -->
                            <Border Margin="0,4,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=btnLangToggle}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ListBox x:Name="comboLang" Style="{StaticResource LangListBoxStyle}"
                                         Margin="0,0,0,0" SelectedIndex="0"
                                         SelectionChanged="comboLang_SelectionChanged">
                                    <ListBoxItem Style="{StaticResource LangItemStyle}" Tag="zh-CN">
                                        <TextBlock Text="简体中文"/>
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource LangItemStyle}" Tag="en-US">
                                        <TextBlock Text="English"/>
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource LangItemStyle}" Tag="zh-HK">
                                        <TextBlock Text="繁體中文 (HK)"/>
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource LangItemStyle}" Tag="zh-TW">
                                        <TextBlock Text="繁體中文 (TW)"/>
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource LangItemStyle}" Tag="te-Yi">
                                        <TextBlock Text="Music Factory"/>
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource LangItemStyle}" Tag="pc-Ba">
                                        <TextBlock Text="Pseudo"/>
                                    </ListBoxItem>
                                </ListBox>
                            </Border>

                            <Button Margin="0,12,0,0" Click="btnSwitchToClassic_Click"
                                    Background="{StaticResource SubtlePanelBrush}" BorderBrush="{StaticResource BorderLightBrush}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B3;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource Lang_Btn_SwitchToClassic}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Right Content Area ===== -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              Background="{StaticResource AppBackgroundBrush}">
                    <Grid Margin="32,28,32,28">
                        <!-- ===== Page: PPT Optimization ===== -->
                        <StackPanel x:Name="PagePPTOpt" Visibility="Visible">
                            <TextBlock Text="{DynamicResource Lang_Nav_DocOpt}" Style="{StaticResource PageTitleStyle}"/>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Lang_Card_AssocTitle}" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock Text="{DynamicResource Lang_Card_AssocDesc}" Margin="0,4,0,16"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>

                                    <WrapPanel>
                                        <StackPanel Width="220" Margin="0,0,12,12">
                                            <Button Click="btnSetPptQuickMenu_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{DynamicResource Lang_Label_PptSwitch}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Border x:Name="PptQuickMenu" Background="{StaticResource SubtlePanelBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,6,0,0" Visibility="Collapsed">
                                                <StackPanel>
                                                    <Button Margin="0,0,0,6" Click="btnSetPptOfficeQuick_Click">
                                                        <TextBlock Text="{DynamicResource Lang_Btn_SwitchToPpt}"/>
                                                    </Button>
                                                    <Button Click="btnSetPptWpsQuick_Click">
                                                        <TextBlock Text="{DynamicResource Lang_Btn_SwitchToWpsPpt}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Width="220" Margin="0,0,12,12">
                                            <Button Click="btnSetWordQuick_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{DynamicResource Lang_Label_WordSwitch}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Border x:Name="WordQuickMenu" Background="{StaticResource SubtlePanelBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,6,0,0" Visibility="Collapsed">
                                                <StackPanel>
                                                    <Button Margin="0,0,0,6" Click="btnSetWordOfficeQuick_Click">
                                                        <TextBlock Text="{DynamicResource Lang_Btn_SwitchToOffice}"/>
                                                    </Button>
                                                    <Button Click="btnSetWordWpsQuick_Click">
                                                        <TextBlock Text="{DynamicResource Lang_Btn_SwitchToWps}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Width="220" Margin="0,0,12,12">
                                            <Button Click="btnSetExcelQuick_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{DynamicResource Lang_Label_ExcelSwitch}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Border x:Name="ExcelQuickMenu" Background="{StaticResource SubtlePanelBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,6,0,0" Visibility="Collapsed">
                                                <StackPanel>
                                                    <Button Margin="0,0,0,6" Click="btnSetExcelOfficeQuick_Click">
                                                        <TextBlock Text="{DynamicResource Lang_Btn_SwitchToOffice}"/>
                                                    </Button>
                                                    <Button Click="btnSetExcelWpsQuick_Click">
                                                        <TextBlock Text="{DynamicResource Lang_Btn_SwitchToWps}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Width="220" Margin="0,0,12,12">
                                            <Button Click="btnSetPdfQuick_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{DynamicResource Lang_Label_PdfSwitch}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Border x:Name="PdfQuickMenu" Background="{StaticResource SubtlePanelBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,6,0,0" Visibility="Collapsed">
                                                <StackPanel>
                                                    <Button Margin="0,0,0,6" Click="btnSetPdfEdgeQuick_Click">
                                                        <TextBlock Text="{DynamicResource Lang_Btn_SwitchToEdge}"/>
                                                    </Button>
                                                    <Button Click="btnSetPdfWpsQuick_Click">
                                                        <TextBlock Text="{DynamicResource Lang_Btn_SwitchToWps}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </WrapPanel>

                                    <Separator Margin="0,6,0,14"/>
                                    <TextBlock Text="{DynamicResource Lang_Label_SystemRepair}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12"/>

                                    <WrapPanel>
                                        <Button Width="220" Margin="0,0,12,12" Click="btnRestartExplorer_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource Lang_Btn_RestartExplorer}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="220" Margin="0,0,12,12" Click="btnCleanIconCache_Click"
                                                Background="{StaticResource DangerSurfaceBrush}" BorderBrush="{StaticResource DangerBorderBrush}" Foreground="{StaticResource DangerTextBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource Lang_Btn_CleanCache}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>

                                    <TextBlock Text="{DynamicResource Lang_Tip_IconFix}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Page: General ===== -->
                        <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Lang_Nav_General}" Style="{StaticResource PageTitleStyle}"/>

                            <!-- Startup & Monitor Card -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Lang_Card_StartupModeTitle}" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock Text="{DynamicResource Lang_Card_StartupFloatingDesc}" Margin="0,4,0,12"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <RadioButton x:Name="rbStartupMainWindow"
                                                     Content="{DynamicResource Lang_StartupMode_MainWindow}"
                                                     Checked="StartupMode_Changed"/>
                                        <RadioButton x:Name="rbStartupFloatingBall"
                                                     Content="{DynamicResource Lang_StartupMode_FloatingBall}"
                                                     Checked="StartupMode_Changed"/>
                                    </StackPanel>

                                    <Separator/>

                                    <!-- Auto-start -->
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Lang_Card_StartupTitle}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="{DynamicResource Lang_Card_StartupDesc}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="chkRunAtStartup"
                                                      Style="{StaticResource ModernToggleSwitch}"
                                                      Checked="chkRunAtStartup_Checked"
                                                      Unchecked="chkRunAtStartup_Unchecked"/>
                                    </Grid>

                                    <Separator Margin="0,14,0,0"/>

                                    <!-- Monitor -->
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Lang_Card_MonitorTitle}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="{DynamicResource Lang_Card_MonitorDesc}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="chkMonitorPPT"
                                                      Style="{StaticResource ModernToggleSwitch}"
                                                      Checked="ChkMonitorPPT_Checked"
                                                      Unchecked="ChkMonitorPPT_Unchecked"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Quick Fix Card -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Lang_Label_QuickFix}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,14"/>
                                    <WrapPanel>
                                        <Button Width="160" Margin="0,0,10,10" Click="btnCleanWPS_Click">
                                            <TextBlock Text="{DynamicResource Lang_Btn_CleanWPS}"/>
                                        </Button>
                                        <Button Width="160" Margin="0,0,10,10" Click="btnRestartPPTService_Click">
                                            <TextBlock Text="{DynamicResource Lang_Btn_RestartPPT}"/>
                                        </Button>
                                        <Button Width="160" Margin="0,0,10,10" Click="btnSwitchToFloating_Click"
                                                Style="{StaticResource AccentButtonStyle}">
                                            <TextBlock Text="{DynamicResource Lang_Btn_Floating}"/>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Configuration Card -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Configuration" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,14"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="150" Margin="0,0,10,0" Click="btnExportConfig_Click">
                                            <TextBlock Text="{DynamicResource Lang_Btn_ExportConfig}"/>
                                        </Button>
                                        <Button Width="150" Click="btnImportConfig_Click">
                                            <TextBlock Text="{DynamicResource Lang_Btn_ImportConfig}"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Page: Association Center ===== -->
                        <StackPanel x:Name="PageAssociationCenter" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Lang_Nav_AssocCenter}" Style="{StaticResource PageTitleStyle}"/>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Lang_Label_WordAssoc}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10"/>
                                    <TextBlock Text="{DynamicResource Lang_Label_TargetApp}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button x:Name="btnWordOfficeTarget" Tag="Office" Width="200" Margin="0,0,10,8" Click="WordTarget_Click">
                                            <TextBlock Text="Microsoft Office"/>
                                        </Button>
                                        <Button x:Name="btnWordWpsTarget" Tag="WPS" Width="200" Margin="0,0,10,8" Click="WordTarget_Click">
                                            <TextBlock Text="WPS Office"/>
                                        </Button>
                                    </WrapPanel>
                                    <ComboBox x:Name="cmbWordTarget" Visibility="Collapsed">
                                        <ComboBoxItem Content="Microsoft Office" Tag="Office"/>
                                        <ComboBoxItem Content="WPS Office" Tag="WPS"/>
                                    </ComboBox>
                                    <WrapPanel>
                                        <CheckBox x:Name="chkWordDoc" Content=".doc" Margin="0,0,16,8"/>
                                        <CheckBox x:Name="chkWordDocx" Content=".docx" Margin="0,0,16,8"/>
                                        <CheckBox x:Name="chkWordDocm" Content=".docm" Margin="0,0,16,8"/>
                                        <CheckBox x:Name="chkWordDot" Content=".dot" Margin="0,0,16,8"/>
                                        <CheckBox x:Name="chkWordDotx" Content=".dotx" Margin="0,0,16,8"/>
                                        <CheckBox x:Name="chkWordDotm" Content=".dotm" Margin="0,0,16,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Lang_Label_ExcelAssoc}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10"/>
                                    <TextBlock Text="{DynamicResource Lang_Label_TargetApp}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button x:Name="btnExcelOfficeTarget" Tag="Office" Width="200" Margin="0,0,10,8" Click="ExcelTarget_Click">
                                            <TextBlock Text="Microsoft Office"/>
                                        </Button>
                                        <Button x:Name="btnExcelWpsTarget" Tag="WPS" Width="200" Margin="0,0,10,8" Click="ExcelTarget_Click">
                                            <TextBlock Text="WPS Office"/>
                                        </Button>
                                    </WrapPanel>
                                    <ComboBox x:Name="cmbExcelTarget" Visibility="Collapsed">
                                        <ComboBoxItem Content="Microsoft Office" Tag="Office"/>
                                        <ComboBoxItem Content="WPS Office" Tag="WPS"/>
                                    </ComboBox>
                                    <WrapPanel>
                                        <CheckBox x:Name="chkExcelXls" Content=".xls" Margin="0,0,16,8"/>
                                        <CheckBox x:Name="chkExcelXlsx" Content=".xlsx" Margin="0,0,16,8"/>
                                        <CheckBox x:Name="chkExcelXlsm" Content=".xlsm" Margin="0,0,16,8"/>
                                        <CheckBox x:Name="chkExcelXlt" Content=".xlt" Margin="0,0,16,8"/>
                                        <CheckBox x:Name="chkExcelXltx" Content=".xltx" Margin="0,0,16,8"/>
                                        <CheckBox x:Name="chkExcelXltm" Content=".xltm" Margin="0,0,16,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Lang_Label_PdfAssoc}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10"/>
                                    <TextBlock Text="{DynamicResource Lang_Label_TargetApp}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button x:Name="btnPdfEdgeTarget" Tag="Edge" Width="200" Margin="0,0,10,8" Click="PdfTarget_Click">
                                            <TextBlock Text="Microsoft Edge"/>
                                        </Button>
                                        <Button x:Name="btnPdfWpsTarget" Tag="WPS" Width="200" Margin="0,0,10,8" Click="PdfTarget_Click">
                                            <TextBlock Text="WPS Office"/>
                                        </Button>
                                    </WrapPanel>
                                    <ComboBox x:Name="cmbPdfTarget" Visibility="Collapsed">
                                        <ComboBoxItem Content="Microsoft Edge" Tag="Edge"/>
                                        <ComboBoxItem Content="WPS Office" Tag="WPS"/>
                                    </ComboBox>
                                    <WrapPanel Margin="0,0,0,10">
                                        <CheckBox x:Name="chkPdfPdf" Content=".pdf" Margin="0,0,16,8"/>
                                    </WrapPanel>
                                    <Button Width="220" HorizontalAlignment="Left" Click="btnApplyAssociations_Click" Style="{StaticResource AccentButtonStyle}">
                                        <TextBlock Text="{DynamicResource Lang_Btn_ApplySelectedAssoc}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Page: Theme & URL ===== -->
                        <StackPanel x:Name="PageThemeUrl" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Lang_Nav_ThemeUrl}" Style="{StaticResource PageTitleStyle}"/>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Lang_Label_Theme}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10"/>
                                    <TextBlock Text="{DynamicResource Lang_Label_MonetTheme}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <ListBox x:Name="lstThemePreset" Style="{StaticResource LangListBoxStyle}"
                                             SelectionChanged="ThemePreset_SelectionChanged" SelectedIndex="0" Width="300">
                                        <ListBoxItem Style="{StaticResource LangItemStyle}" Tag="MonetWaterLilies">
                                            <TextBlock Text="{DynamicResource Lang_ThemePreset_WaterLilies}"/>
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource LangItemStyle}" Tag="MonetSunrise">
                                            <TextBlock Text="{DynamicResource Lang_ThemePreset_Sunrise}"/>
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource LangItemStyle}" Tag="MonetGarden">
                                            <TextBlock Text="{DynamicResource Lang_ThemePreset_Garden}"/>
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource LangItemStyle}" Tag="MonetTwilight">
                                            <TextBlock Text="{DynamicResource Lang_ThemePreset_Twilight}"/>
                                        </ListBoxItem>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Lang_Label_UrlInvoke}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10"/>
                                    <TextBlock Text="{DynamicResource Lang_Label_UrlInvokeTip}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtInvokeUrl" Height="34" Margin="0,0,0,10"/>
                                    <Button Width="180" HorizontalAlignment="Left" Click="btnInvokeUrl_Click" Style="{StaticResource AccentButtonStyle}">
                                        <TextBlock Text="{DynamicResource Lang_Btn_InvokeUrl}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Page: About ===== -->
                        <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Lang_Nav_About}" Style="{StaticResource PageTitleStyle}"/>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="txtVersionDisplay" Text="CWS" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{DynamicResource Lang_About_Author}" Margin="0,12,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                    <TextBlock Text="{DynamicResource Lang_About_Desc}" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>

                                    <Separator Margin="0,16,0,16"/>

                                    <Button x:Name="btnCheckUpdate" Width="200" HorizontalAlignment="Left"
                                            Click="btnCheckUpdate_Click" Style="{StaticResource AccentButtonStyle}">
                                        <TextBlock Text="{DynamicResource Lang_About_CheckUpdate}"/>
                                    </Button>
                                    <TextBlock x:Name="txtUpdateStatus" Margin="0,10,0,0" Visibility="Collapsed"
                                               Cursor="Hand" TextDecorations="Underline" Foreground="{StaticResource AccentBrush}" FontSize="12"
                                               MouseLeftButtonDown="txtUpdateStatus_MouseLeftButtonDown"/>

                                    <Separator Margin="0,16,0,16"/>

                                    <TextBlock Text="{DynamicResource Lang_About_License}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>

                                    <Button x:Name="btnExportLogs" Width="200" HorizontalAlignment="Left"
                                            Margin="0,16,0,0" Click="btnExportLogs_Click">
                                        <TextBlock Text="{DynamicResource Lang_Btn_ExportLogs}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Toast Notification Panel -->
                <StackPanel x:Name="ToastPanel" Grid.Column="1"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,16,24,0" Panel.ZIndex="100"/>

            </Grid>
        </Grid>
    </Border>
</Window>
